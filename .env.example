# Shared
NODE_ENV=development

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
API_RATE_LIMIT_MAX=600
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Web
# Kosongkan bila web & API berada di balik satu domain/reverse proxy (disarankan di VPS).
NEXT_PUBLIC_API_URL=
# Alamat API yang dipanggil server Next saat merewrite /api/*
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database — Supabase PostgreSQL
# Transaction Pooler (port 6543) untuk runtime
# PENTING: connection_limit=10 (bukan 1) agar worker bisa handle query paralel
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30&sslmode=require
# Direct Connection (port 5432) untuk prisma push/migrate
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption (32 chars untuk enkripsi session Telegram)
SESSION_ENCRYPTION_KEY=12345678901234567890123456789012

# Worker safety
MIN_SPACING_MS=5000
RUN_POLL_INTERVAL_MS=3000
SCHEDULE_POLL_INTERVAL_MS=30000
