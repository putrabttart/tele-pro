# Shared
NODE_ENV=development

# API
API_PORT=4000
JWT_SECRET=change_me_super_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
API_BASE_URL=http://localhost:4000
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (Local default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_broadcast?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/telegram_broadcast?schema=public

# Supabase PostgreSQL example
# Use Transaction Pooler URL for DATABASE_URL (runtime)
# Use Direct Connection URL for DIRECT_URL (migrate/schema)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Optional (if later using Supabase SDK in app)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption (32 chars recommended)
SESSION_ENCRYPTION_KEY=12345678901234567890123456789012

# Worker safety
MIN_SPACING_MS=5000
RUN_POLL_INTERVAL_MS=3000
SCHEDULE_POLL_INTERVAL_MS=30000
