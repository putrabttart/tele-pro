# Shared
NODE_ENV=development

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database — Supabase PostgreSQL
# Transaction Pooler (port 6543) untuk runtime
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Direct Connection (port 5432) untuk prisma push/migrate
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption (32 chars untuk enkripsi session Telegram)
SESSION_ENCRYPTION_KEY=12345678901234567890123456789012

# Worker safety
MIN_SPACING_MS=5000
RUN_POLL_INTERVAL_MS=3000
SCHEDULE_POLL_INTERVAL_MS=30000
